<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>پارۂ تشنگی</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&family=Mirza:wght@400;500;700&family=Caveat:wght@400;500;600;700&display=swap');

:root{
  --bg1:#070A10; --bg2:#0C121C; --bg3:#050709;
  --gold:#CDA34E; --gold-lt:#EFD9A0; --gold-dim:#7C6132; --gold-line:rgba(205,163,78,0.35);
  --card-blue-a:#173254; --card-blue-b:#0A1826;
  --card-green-a:#144230; --card-green-b:#08190F;
  --ink:#EDE3CC; --ink-dim:#B9AC8B;
  --panel:#111823; --panel-2:#0B121B;
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0; padding:0; height:100%;}
body{
  font-family:'Kalam', cursive;
  color:var(--ink);
  background:
    radial-gradient(ellipse at 50% -10%, rgba(205,163,78,0.08), transparent 45%),
    radial-gradient(circle at 15% 20%, rgba(205,163,78,0.05), transparent 30%),
    radial-gradient(circle at 85% 75%, rgba(205,163,78,0.04), transparent 35%),
    linear-gradient(180deg, var(--bg2) 0%, var(--bg1) 55%, var(--bg3) 100%);
  min-height:100vh; overflow-x:hidden;
}
.dust{position:fixed; inset:0; pointer-events:none; z-index:1; opacity:0.5;
  background-image:
    radial-gradient(1px 1px at 20% 30%, rgba(205,163,78,0.5), transparent),
    radial-gradient(1px 1px at 70% 15%, rgba(205,163,78,0.4), transparent),
    radial-gradient(1px 1px at 85% 55%, rgba(205,163,78,0.35), transparent),
    radial-gradient(1px 1px at 35% 70%, rgba(205,163,78,0.3), transparent),
    radial-gradient(1px 1px at 55% 40%, rgba(205,163,78,0.4), transparent),
    radial-gradient(1px 1px at 10% 85%, rgba(205,163,78,0.3), transparent);
  background-size:300px 300px;
}

#app{position:relative; width:100%; min-height:100vh; z-index:2;}
.screen{display:none; min-height:100vh; padding:20px 16px 40px; max-width:520px; margin:0 auto;}
.screen.active{display:block;}

.gear{
  position:fixed; top:18px; right:18px; z-index:20; width:38px; height:38px; border-radius:50%;
  border:1px solid var(--gold-line); background:rgba(13,18,26,0.6); backdrop-filter:blur(4px);
  display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--gold);
}

.ornament{display:flex; align-items:center; justify-content:center; gap:10px; color:var(--gold-dim); margin:14px 0;}
.ornament .ln{width:26px; height:1px; background:linear-gradient(90deg, transparent, var(--gold-line));}
.ornament .ln.r{background:linear-gradient(90deg, var(--gold-line), transparent);}
.ornament .dot{font-size:10px; color:var(--gold);}

/* ---------- HOME ---------- */
.emblem-wrap{margin-top:26px;}
.author-name{
  font-family:'Mirza', serif; direction:rtl; font-size:17px; color:var(--gold);
  text-align:center; letter-spacing:1px; opacity:0.9; margin-top:2px;
}
.author-name.hi{font-family:'Kalam', cursive; direction:ltr; font-size:15px;}

.section-heading{
  text-align:center; font-family:'Mirza', serif; direction:rtl; color:var(--gold);
  font-size:20px; margin-top:34px;
}

.preview-row{
  display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-top:18px;
}
.pcard{
  position:relative; aspect-ratio:3/4; border-radius:14px; overflow:hidden; cursor:pointer;
  border:1px solid var(--gold-line); box-shadow:0 10px 24px rgba(0,0,0,0.4);
  display:flex; align-items:flex-end;
}
.pcard .bgfx{position:absolute; inset:0;}
.pcard .fade{position:absolute; inset:0; background:linear-gradient(180deg, transparent 30%, rgba(4,6,9,0.85) 100%);}
.pcard .txt{position:relative; z-index:2; padding:10px 6px 8px; width:100%; text-align:center;}
.pcard .matla{font-family:'Mirza', serif; direction:rtl; font-size:12.5px; color:var(--ink); line-height:1.45;}
.pcard .num{margin-top:5px; font-family:'Caveat', cursive; color:var(--gold); font-size:13px; letter-spacing:1px;}
.pcard.empty{align-items:center; justify-content:center; cursor:default;}
.pcard.empty .txt{text-align:center; color:var(--gold-dim); font-family:'Kalam', cursive; font-size:13px;}

